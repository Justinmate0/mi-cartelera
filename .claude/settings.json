{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Edit(./.env)", "Edit(./.env.local)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/formatear.cjs\""
          }
        ]
      }
    ]
  }
}
