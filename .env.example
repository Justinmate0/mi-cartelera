# Copia este archivo como .env y pon tus valores reales.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).

# Supabase: Project Settings > API (Project URL y la anon/publishable key)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# TMDB: Settings > API (API Read Access Token, el largo)
VITE_TMDB_TOKEN=tu-token-de-lectura-de-tmdb
